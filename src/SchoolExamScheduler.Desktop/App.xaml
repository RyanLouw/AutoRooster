<Application x:Class="SchoolExamScheduler.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Resources>
<Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/></Style>
<Style TargetType="TextBox"><Setter Property="Margin" Value="4,3,4,8"/><Setter Property="Padding" Value="6"/></Style>
<Style TargetType="ComboBox"><Setter Property="Margin" Value="4,3,4,8"/><Setter Property="Padding" Value="6"/></Style>
<Style TargetType="CheckBox"><Setter Property="Margin" Value="4,6"/></Style>
<Style TargetType="DataGrid"><Setter Property="RowHeight" Value="34"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
<Style x:Key="LicensedAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="IsEnabled" Value="{Binding DataContext.Subscription.CanWrite,RelativeSource={RelativeSource AncestorType=Window}}"/></Style>
</Application.Resources></Application>
