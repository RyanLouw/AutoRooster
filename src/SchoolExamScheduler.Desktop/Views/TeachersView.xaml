<UserControl x:Class="SchoolExamScheduler.Desktop.Views.TeachersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal"><TextBlock Text="Search teachers" VerticalAlignment="Center"/><TextBox Width="220" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Active only" IsChecked="{Binding ActiveOnly}" VerticalAlignment="Center"/><Button Content="Refresh" Command="{Binding LoadCommand}"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
<DataGrid ItemsSource="{Binding FilteredTeachers}" SelectedItem="{Binding SelectedTeacher}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,16,0"><DataGrid.Columns>
<DataGridTextColumn Header="First name" Binding="{Binding FirstName}" Width="*"/><DataGridTextColumn Header="Surname" Binding="{Binding LastName}" Width="*"/><DataGridTextColumn Header="Weight" Binding="{Binding WorkloadWeight}"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive,Mode=OneWay}"/><DataGridCheckBoxColumn Header="Eligible" Binding="{Binding CanInvigilate,Mode=OneWay}"/>
</DataGrid.Columns></DataGrid>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Teacher details" FontSize="20" Margin="4,8"/><TextBlock Text="First name"/><TextBox Text="{Binding FirstName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Surname"/><TextBox Text="{Binding LastName,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Employee number (optional)"/><TextBox Text="{Binding EmployeeNumber}"/><TextBlock Text="Email (optional)"/><TextBox Text="{Binding Email}"/>
<TextBlock Text="Workload weight (default 1.0)"/><TextBox Text="{Binding WorkloadWeight,ValidatesOnExceptions=True}"/><TextBlock Text="1.0 = normal share; 0.5 = reduced share for other responsibilities. Save, then generate a new roster to redistribute hours. Explain the responsibility in Notes." TextWrapping="Wrap" Margin="4,4,4,12"/>
<TextBlock Text="Daily maximum minutes (blank = default)"/><TextBox Text="{Binding MaximumDailyMinutes,ValidatesOnExceptions=True}"/>
<TextBlock Text="Period maximum minutes (blank = no limit)"/><TextBox Text="{Binding MaximumPeriodMinutes,ValidatesOnExceptions=True}"/>
<CheckBox Content="Active" IsChecked="{Binding IsActive}"/><CheckBox Content="Can invigilate" IsChecked="{Binding CanInvigilate}"/>
<TextBlock Text="Notes"/><TextBox Text="{Binding Notes}" AcceptsReturn="True" MinHeight="50"/>
<WrapPanel><Button Content="New teacher" Command="{Binding NewCommand}"/><Button Content="Save teacher" Command="{Binding SaveCommand}"/><Button Content="Deactivate" Command="{Binding DeactivateCommand}"/></WrapPanel>
</StackPanel></ScrollViewer></Grid>
<StackPanel Grid.Row="2"><ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3"/><TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel>
</Grid></UserControl>
