<UserControl x:Class="SchoolExamScheduler.Desktop.Views.ExaminationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SchoolExamScheduler.Desktop"><UserControl.Resources><local:SubjectNameConverter x:Key="SubjectName"/></UserControl.Resources><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions><DockPanel Margin="0,0,16,0"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="180" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search grade, subject or description"/><CheckBox Content="Selected date only" IsChecked="{Binding DateOnlyFilter}"/><Button Content="Refresh" Command="{Binding LoadCommand}"/></StackPanel><DataGrid ItemsSource="{Binding FilteredExams}" SelectedItem="{Binding SelectedExam}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding ExamDate,StringFormat=yyyy-MM-dd}"/><DataGridTemplateColumn Header="Subject"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource SubjectName}"><Binding Path="SubjectId"/><Binding Path="DataContext.Subjects" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Grade" Binding="{Binding Grade}"/><DataGridTextColumn Header="Start" Binding="{Binding StartTime,StringFormat=HH:mm}"/><DataGridTextColumn Header="End" Binding="{Binding EndTime,StringFormat=HH:mm}"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Examination details" FontSize="20"/><TextBlock Text="Subject"/><ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" DisplayMemberPath="Name"/><TextBlock Text="Grade"/><TextBox Text="{Binding Grade,ValidatesOnExceptions=True}"/><DatePicker SelectedDate="{Binding Date}"/><Expander Header="Calendar"><Calendar SelectedDate="{Binding Date}"/></Expander><TextBlock Text="Start / end (HH:mm, same date)"/><TextBox Text="{Binding StartTime}"/><TextBox Text="{Binding EndTime}"/><TextBlock Text="Description"/><TextBox Text="{Binding Description}"/><CheckBox Content="Active" IsChecked="{Binding ExamActive}"/><TextBlock Text="Allocate venues" FontSize="18"/><TextBlock Text="Invigilators at once is the number of teachers needed simultaneously in a room. With handovers enabled, different teachers can cover successive segments of each position." TextWrapping="Wrap" Margin="4,6"/><ComboBox ItemsSource="{Binding Venues}" SelectedItem="{Binding SelectedVenue}" DisplayMemberPath="Name"/><WrapPanel><Button Content="Add venue" Command="{Binding AddVenueCommand}"/><Button Content="Remove venue" Command="{Binding RemoveVenueCommand}"/></WrapPanel><DataGrid Height="140" ItemsSource="{Binding Allocations}" SelectedItem="{Binding SelectedAllocation}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridComboBoxColumn Header="Venue" SelectedValueBinding="{Binding VenueId}" SelectedValuePath="Id" DisplayMemberPath="Name"><DataGridComboBoxColumn.ElementStyle><Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.Venues,RelativeSource={RelativeSource AncestorType=UserControl}}"/></Style></DataGridComboBoxColumn.ElementStyle><DataGridComboBoxColumn.EditingElementStyle><Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.Venues,RelativeSource={RelativeSource AncestorType=UserControl}}"/></Style></DataGridComboBoxColumn.EditingElementStyle></DataGridComboBoxColumn><DataGridTextColumn Header="Students" Binding="{Binding StudentCount,ValidatesOnExceptions=True}"/><DataGridTextColumn Header="Invigilators at once" Binding="{Binding InvigilatorCount,ValidatesOnExceptions=True}"/></DataGrid.Columns></DataGrid><WrapPanel><Button Content="New" Command="{Binding NewCommand}"/><Button Content="Copy" Command="{Binding CopyCommand}"/><Button Content="Save examination" Command="{Binding SaveCommand}"/></WrapPanel><TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/><ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}"/></StackPanel></ScrollViewer></Grid></UserControl>