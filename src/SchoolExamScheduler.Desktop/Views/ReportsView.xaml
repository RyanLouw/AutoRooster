<UserControl x:Class="SchoolExamScheduler.Desktop.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><WrapPanel><ComboBox Width="260" ItemsSource="{Binding VisibleRosters}" SelectedItem="{Binding SelectedRoster}" DisplayMemberPath="DisplayName"/><CheckBox Content="Show previous series" IsChecked="{Binding ShowPreviousSeries}"/><Button Content="Refresh versions" Command="{Binding LoadCommand}"/><Button Content="Load report" Command="{Binding BuildReportCommand}"/><TextBlock Text="{Binding Report.Period}" VerticalAlignment="Center"/></WrapPanel><WrapPanel><Button Content="Export ALL reports (ZIP)" Command="{Binding ExportAllCommand}"/><Button Content="Export teacher hours (PDF)" Command="{Binding ExportTeacherHoursCommand}"/><Button Content="Export Excel workbook" Command="{Binding ExportExcelCommand}"/><ComboBox Width="245" ItemsSource="{Binding ExportOptions}" DisplayMemberPath="Label" SelectedValuePath="Kind" SelectedValue="{Binding ExportKind}"/><Button Content="Export PDF" Command="{Binding ExportPdfCommand}"/><TextBlock Text="{Binding ExportStatus}" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="Teacher hours covers every teacher across the selected roster period. Timetables show each invigilator position, exact handover times and split sessions. Export all includes the full period, regardless of table filters. Excel includes Editable roster with teacher dropdowns and Editable hours with automatic totals for final manual adjustments; these edits do not change the app." TextWrapping="Wrap" Margin="4,6"/><TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel><TabControl><TabItem Header="Dashboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="{Binding Report.SchoolName}" FontSize="24"/><TextBlock Text="{Binding Report.RosterName}" Font