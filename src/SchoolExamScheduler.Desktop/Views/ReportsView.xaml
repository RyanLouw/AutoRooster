rgetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding LargeDeviation}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Grid.Column="1"><Border Background="#2F6FA3" Height="10" Width="{Binding ActualWidth}" HorizontalAlignment="Left"/><Border Background="#9AA7B4" Height="6" Margin="0,3,0,0" Width="{Binding TargetWidth}" HorizontalAlignment="Left"/></StackPanel><TextBlock Grid.Column="2"><Run Text="{Binding ActualHours,StringFormat=F2,Mode=OneWay}"/><Run Text=" hours / target "/><Run Text="{Binding TargetHours,StringFormat=F2,Mode=OneWay}"/><Run Text=" hours"/></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem><TabItem Header="Examination / teacher roster"><DockPanel><WrapPanel DockPanel.Dock="Top"><ComboBox Width="200" ItemsSource="{Binding Teachers}" SelectedItem="{Binding SelectedTeacher}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding FirstName,Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding LastName,Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Width="200" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search teacher, grade, subject or venue"/><Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"/><TextBlock Text="{Binding FilteredMinutes,StringFormat='Selected minutes: {0}'}" VerticalAlignment="Center"/></WrapPanel><DataGrid ItemsSource="{Binding FilteredDuties}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}"/><DataGridTextColumn Header="Exam" Binding="{Binding Examination}"/><DataGridTextColumn Header="Venue" Binding="{Binding Venue}"/><DataGridTextColumn Header="Position" Binding="{Binding Position}"/><DataGridTextColumn Header="Start" Binding="{Binding Start,StringFormat=HH:mm}"/><DataGridTextColumn Header="End" Binding="{Binding End,StringFormat=HH:mm}"/><DataGridTextColumn Header="Teacher" Binding="{Binding Teacher}" Width="*"/><DataGridTextColumn Header="Hours" Binding="{Binding Hours,StringFormat=F2}"/><DataGridTextColumn Header="Session" Binding="{Binding Session}"/></DataGrid.Columns></DataGrid></DockPanel></TabItem><TabItem Header="Calendar"><DockPanel><StackPanel DockPanel.Dock="Left" Width="260"><Calendar SelectedDate="{Binding SelectedDate}"/><CheckBox Content="Filter to selected date" IsChecked="{Binding FilterDate}"/><Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"/></StackPanel><DataGrid ItemsSource="{Binding FilteredDuties}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}"/><DataGridTextColumn Header="Start" Binding="{Binding Start,StringFormat=HH:mm}"/><DataGridTextColumn Header="End" Binding="{Binding End,StringFormat=HH:mm}"/><DataGridTextColumn Header="Examination" Binding="{Binding Examination}"/><DataGridTextColumn Header="Venue" Binding="{Binding Venue}"/><DataGridTextColumn Header="Teacher" Binding="{Binding Teacher}" Width="*"/><DataGridTextColumn Header="Hours" Binding="{Binding Hours,StringFormat=F2}"/><DataGridTextColumn Header="Session" Binding="{Binding Session}"/></DataGrid.Columns></DataGrid></DockPanel></TabItem><TabItem Header="Workload statistics"><DataGrid ItemsSource="{Binding Workloads}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Teacher" Binding="{Binding Teacher}"/><DataGridTextColumn Header="Weight" Binding="{Binding Weight}"/><DataGridTextColumn Header="Eligible minutes" Binding="{Binding AvailableMinutes}"/><DataGridTextColumn Header="Target hours" Binding="{Binding TargetHours,StringFormat=F2}"/><DataGridTextColumn Header="Total hours" Binding="{Binding ActualHours,StringFormat=F2}"/><DataGridTextColumn Header="Total hh:mm" Binding="{Binding Duration}"/><DataGridTextColumn Header="Difference"