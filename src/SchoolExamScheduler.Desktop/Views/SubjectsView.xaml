<UserControl x:Class="SchoolExamScheduler.Desktop.Views.SubjectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Right" Width="300" Margin="16,0,0,0"><TextBlock Text="Subject details" FontSize="20"/><Button Style="{StaticResource LicensedAction}" Content="Add school subject catalogue" Command="{Binding AddSubjectCatalogueCommand}"/><TextBlock Text="A broad South African secondary-school starting list. Add, rename or deactivate subjects to match your school." TextWrapping="Wrap" Margin="4,8"/><TextBlock Text="Name"/><TextBox Text="{Binding SubjectName}"/><TextBlock Text="Code"/><TextBox Text="{Binding SubjectCode}"/><CheckBox Content="Active" IsChecked="{Binding SubjectActive}"/><WrapPanel><Button Content="New" Command="{Binding NewSubjectCommand}"/><Button Style="{StaticResource LicensedAction}" Content="Save" Command="{Binding SaveSubjectCommand}"/><Button Content="Refresh" Command="{Binding LoadCommand}"/></WrapPanel><TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel><DataGrid ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Code" Binding="{Binding SubjectCode}"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive,Mode=OneWay}"/></DataGrid.Columns></DataGrid></DockPanel></UserControl>