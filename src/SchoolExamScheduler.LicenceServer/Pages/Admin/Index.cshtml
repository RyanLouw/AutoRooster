@page
@model SchoolExamScheduler.LicenceServer.Pages.Admin.IndexModel
<h2>Schools and manual renewals</h2><p>Check your bank statement first. After receiving payment, choose the new paid-through date and record the bank reference. No payment gateway is connected.</p>
<div asp-validation-summary="All" class="error"></div>
@if(Model.Notice is not null){<p class="notice">@Model.Notice</p>}
@if(Model.NewKey is not null){<section class="notice"><strong>Copy this licence key now. It is shown once:</strong><p><code id="new-key">@Model.NewKey</code></p></section>}
<details open><summary>Create a school licence</summary><form method="post" asp-page-handler="Create" asp-antiforgery="true" class="fields"><label>School name<input name="School" required maxlength="200"/></label><label>Contact email / phone<input name="Contact" maxlength="254"/></label><label>Paid through (inclusive)<input name="PaidThrough" type="date" value="@Model.DefaultPaidThrough" required/></label><label>Allowed installations<input name="MaximumDevices" type="number" min="1" max="20" value="2" required/></label><button>Create licence</button></form></details>
@foreach(var licence in Model.Licences)
{
<section class="school" id="licence-@licence.Id.ToString("N")"><h3>@licence.School</h3><p>@licence.Contact · Payment reference: <strong>@licence.PaymentReference</strong> · Key ends @licence.KeySuffix</p><p><strong>@(!licence.Enabled?"Switched off":licence.PaidUntilUtc<=Model.Now?"Expired":"Active")</strong> · Paid through @LicenceDates.PaidThrough(licence.PaidUntilUtc).ToString("dd MMM yyyy") · Installations @licence.Devices / @licence.MaximumDevices</p>
<form method="post" asp-page-handler="Extend" asp-antiforgery="true" class="fields"><input type="hidden" name="Id" value="@licence.Id"/><input type="hidden" name="Revision" value="@licence.Revision"/><label>New paid-through date<input name="PaidThrough" type="date" required/></label><label>Bank-statement reference<input name="BankReference" required maxlength="120"/></label><label>Payment / reconciliation notes<input name="Note" maxlength="700"/></label><button>Record payment / extend</button></form>
<div class="actions"><form method="post" asp-page-handler="Switch" asp-antiforgery="true"><input type="hidden" name="Id" value="@licence.Id"/><input type="hidden" name="Revision" value="@licence.Revision"/><input type="hidden" name="Enabled" value="@((!licence.Enabled).ToString())"/><button class="@(!licence.Enabled?"":"danger")">@(!licence.Enabled?"Enable licence":"Switch off licence")</button></form><form method="post" asp-page-handler="ReplaceKey" asp-antiforgery="true"><input type="hidden" name="Id" value="@licence.Id"/><input type="hidden" name="Revision" value="@licence.Revision"/><button>Replace lost key</button></form><form method="post" asp-page-handler="ResetDevices" asp-antiforgery="true"><input type="hidden" name="Id" value="@licence.Id"/><input type="hidden" name="Revision" value="@licence.Revision"/><button>Reset installations</button></form><a asp-page="/Admin/Index" asp-route-history="@licence.Id">View audit history</a></div></section>
}
@if(Model.History.Count>0){<h2>Recent licence history</h2><table><thead><tr><th>When (South Africa)</th><th>Action</th><th>Owner</th><th>Details</th></tr></thead><tbody>@foreach(var item in Model.History){<tr><td>@item.AtUtc.ToOffset(TimeSpan.FromHours(2)).ToString("yyyy-MM-dd HH:mm")</td><td>@item.Action</td><td>@item.Actor</td><td>@item.Note</td></tr>}</tbody></table>}
