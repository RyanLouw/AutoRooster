<Window x:Class="SchoolExamScheduler.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SchoolExamScheduler.Desktop.Views" Title="School Exam Invigilation Scheduler" Width="1200" Height="760" MinWidth="1000" MinHeight="650" Background="#F3F5F8">
<DockPanel><Border DockPanel.Dock="Top" Background="#16324F" Padding="24,16"><TextBlock Text="School Exam Invigilation Scheduler" FontSize="24" Foreground="White"/></Border>
<Border DockPanel.Dock="Top" Background="#FFF1CE" Padding="16,8"><TextBlock Text="{Binding Subscription.State.Message}" TextWrapping="Wrap"/></Border>
<TabControl x:Name="Workspaces" Margin="12" SelectionChanged="WorkspaceChanged"><TabItem Header="Teachers"><views:TeachersView DataContext="{Binding Teachers}"/></TabItem><TabItem Header="Teacher Availability"><views:AvailabilityView DataContext="{Binding Availability}"/></TabItem><TabItem Header="Subjects"><views:SubjectsView DataContext="{Binding ReferenceData}"/></TabItem><TabItem Header="Venues"><views:VenuesView DataContext="{Binding ReferenceData}"/></TabItem><TabItem Header="Examinations"><views:ExaminationsView DataContext="{Binding Examinations}"/></TabItem><TabItem Header="Generate Roster"><views:GenerationView DataContext="{Binding Generation}"/></TabItem><TabItem Header="Review Roster"><views:ReviewView DataContext="{Binding Review}"/></TabItem><TabItem Header="Dashboard / Reports"><views:ReportsView DataContext="{Binding Reports}"/></TabItem><TabItem Header="Settings"><views:SettingsView DataContext="{Binding Settings}"/></TabItem><TabItem Header="Subscription"><views:SubscriptionView DataContext="{Binding Subscription}"/></TabItem></TabControl></DockPanel></Window>