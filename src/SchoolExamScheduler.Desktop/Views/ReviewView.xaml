<UserControl x:Class="SchoolExamScheduler.Desktop.Views.ReviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><WrapPanel><ComboBox Width="260" ItemsSource="{Binding VisibleRosters}" SelectedItem="{Binding SelectedRoster}" DisplayMemberPath="DisplayName"/><CheckBox Content="Show previous series" IsChecked="{Binding ShowPreviousSeries}"/><Button Content="Refresh versions" Command="{Binding LoadCommand}"/><Button Content="Load / validate roster" Command="{Binding LoadDutiesCommand}"/><TextBox Width="220" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search teacher, examination, date or venue"/></WrapPanel><TextBlock Text="{Binding SelectedRoster.Status,StringFormat='Version status: {0}'}"/><TextBlock Text="{Binding ValidationStatus}" TextWrapping="Wrap"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding FilteredDuties}" SelectedItem="{Binding SelectedDuty}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,16,0"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date,StringFormat=yyyy-MM-dd}"/><DataGridTextColumn Header="Exam" Binding="{Binding Examination}"/><DataGridTextColumn Header="Venue" Binding="{Binding Venue}"/><DataGridTextColumn Header="Position" Binding="{Binding Position}"/><DataGridTextColumn Header="Start" Binding="{Binding Start,StringFormat=HH:mm}"/><DataGridTextColumn Header="End" Binding="{Binding End,StringFormat=HH:mm}"/><DataGridTextColumn Header="Teacher" Binding="{Binding Teacher}" Width="*"/><DataGridCheckBoxColumn Header="Locked" Binding="{Binding IsLocked,Mode=OneWay}"/></DataGrid.Columns></DataGrid><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEdit}"><StackPanel><TextBlock Text="Manual editing" FontSize="20"/><TextBlock Text="Replacement / second-segment teacher" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding Teachers}" SelectedItem="{Binding ReplacementTeacher}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding FirstName,Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding LastName,Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Style="{StaticResource LicensedAction}" Content="Replace teacher" Command="{Binding ReplaceCommand}"/><TextBlock Text="Handover time (HH:mm)"/><TextBox Text="{Binding Handover}"/><Button Style="{StaticResource LicensedAction}" Content="Split selected duty" Command="{Binding SplitCommand}"/><TextBlock Text="Second duty for swap / combine"/><ComboBox ItemsSource="{Binding Duties}" SelectedItem="{Binding SecondDuty}" DisplayMemberPath="Label"/><Button Style="{StaticResource LicensedAction}" Content="Swap teachers" Command="{Binding SwapCommand}"/><Button Style="{StaticResource LicensedAction}" Content="Combine adjacent duties" Command="{Binding CombineCommand}"/><Button Style="{StaticResource LicensedAction}" Content="Lock / unlock selected duty" Command="{Binding ToggleLockCommand}"/><Button Style="{StaticResource LicensedAction}" Content="Remove selected duty" Command="{Binding RemoveCommand}"/><Separator/><Button Style="{StaticResource LicensedAction}" Content="Regenerate unlocked duties" Command="{Binding RegenerateCommand}"/><Button Style="{StaticResource LicensedAction}" Content="Finalize roster" Command="{Binding FinalizeCommand}"/><TextBlock Text="Regeneration creates a new version and preserves exact locked duties. Finalized versions are read-only." TextWrapping="Wrap" Foreground="#536174"/></StackPanel></ScrollViewer></Grid><StackPanel Grid.Row="2"><TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Issues}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" Foreground="#B42318" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}"/></StackPanel></Grid></UserControl>
