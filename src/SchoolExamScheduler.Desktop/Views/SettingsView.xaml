<UserControl x:Class="SchoolExamScheduler.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="School and scheduling settings" FontSize="22"/><TextBlock Text="School name"/><TextBox Text="{Binding Settings.SchoolName,ValidatesOnExceptions=True}"/><TextBlock Text="Minimum break minutes"/><TextBox Text="{Binding Settings.MinimumBreakMinutes,ValidatesOnExceptions=True}"/><TextBlock Text="Default daily maximum minutes"/><TextBox Text="{Binding Settings.DefaultMaximumDailyMinutes,ValidatesOnExceptions=True}"/><TextBlock Text="Minimum split-session minutes"/><TextBox Text="{Binding Settings.MinimumSessionMinutes,ValidatesOnExceptions=True}"/><TextBlock Text="Maximum segments per position"/><TextBox Text="{Binding Settings.MaximumSessionSegmentsPerPosition,ValidatesOnExceptions=True}"/><TextBlock Text="Time increment minutes"/><TextBox Text="{Binding Settings.SchedulingTimeIncrementMinutes,ValidatesOnExceptions=True}"/><TextBlock Text="Fairness priority enabled when positive"/><TextBox Text="{Binding Settings.FairnessWeight,ValidatesOnExceptions=True}"/><TextBlock Text="Daily balance weight"/><TextBox Text="{Binding Settings.DailyBalanceWeight,ValidatesOnExceptions=True}"/><TextBlock Text="Duty count weight"/><TextBox Text="{Binding Settings.DutyCountBalanceWeight,ValidatesOnExceptions=True}"/><TextBlock Text="Unused teacher priority enabled when positive"/><TextBox Text="{Binding Settings.UnassignedTeacherPenalty,ValidatesOnExceptions=True}"/><TextBlock Text="Solver time limit seconds"/><TextBox Text="{Binding Settings.SolverTimeLimitSeconds,ValidatesOnExceptions=True}"/><TextBlock Text="Scheduling seed"/><TextBox Text="{Binding Settings.SchedulingSeed,ValidatesOnExceptions=True}"/><TextBlock Text="Examination-day start (HH:mm)"/><TextBox Text="{Binding DayStart}"/><TextBlock Text="Examination-day end (HH:mm)"/><TextBox Text="{Binding DayEnd}"/><Button Content="Enable 30-minute handovers (all grades)" Command="{Binding EnableThirtyMinuteHandoversCommand}"/><TextBlock Text="Splitting is allowed in every grade, including Grades 8 and 9. Handovers can be 30 minutes or longer; regenerate a new roster after changing settings." TextWrapping="Wrap" Margin="4,8"/><CheckBox Content="Allow session splitting" IsChecked="{Binding Settings.AllowSessionSplitting}"/><CheckBox Content="Automatic backup before roster changes / deletions" IsChecked="{Binding Settings.AutomaticBackupBeforeChanges}"/><WrapPanel><Button Content="Save settings" Command="{Binding SaveCommand}"/><Button Content="Reload settings" Command="{Binding LoadCommand}"/></WrapPanel></StackPanel><StackPanel Grid.Column="1" Margin="32,0,0,0"><TextBlock Text="Database backups" FontSize="22"/><TextBlock Text="Backups use SQLite's online backup API and are integrity checked. Restore requires confirmation and retains a recovery copy. Backups must match this application's schema version." TextWrapping="Wrap" Margin="0,12"/><Button Content="Create backup" Command="{Binding BackupCommand}"/><Button Content="Restore backup" Command="{Binding RestoreCommand}"/><Separator Margin="0,24"/><TextBlock Text="Try a demonstration school" FontSize="22"/><Button Content="Open realistic demo (separate database)" Command="{Binding OpenRealisticDemoCommand}"/><TextBlock Text="A separate window with 75 teachers, 49 editable subjects, Grades 8–12, varied exam lengths, multiple invigilators per room, leave and reduced workloads. Generate a roster, change availability or weights, then regenerate to compare. Your test changes are saved in the demo database." TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="For an empty database only. Creates 75 teachers, weighted workloads, leave, partial availability and overlapping exams across ten dates. No sample data is inserted automatically." TextWrapping="Wrap" Margin="0,12"/><Button Content="Create sample school" Command="{Binding SampleDataCommand}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,24"/><TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/><ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}"/></StackPanel></Grid></ScrollViewer></UserControl>