<UserControl x:Class="SchoolExamScheduler.Desktop.Views.GenerationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Generate invigilation roster" FontSize="24"/><TextBlock Text="Roster name"/><TextBox Text="{Binding RosterName}" MaxWidth="500" HorizontalAlignment="Left" MinWidth="300"/><WrapPanel><Button Content="Validate inputs" Command="{Binding ValidateInputsCommand}"/><Button Content="Generate roster" Command="{Binding GenerateCommand}"/><Button Content="Cancel generation" Command="{Binding GenerateCancelCommand}"/></WrapPanel><WrapPanel Margin="4,12"><TextBlock Text="Examinations: "/><TextBlock Text="{Binding ExaminationCount}"/><TextBlock Text="   Positions: "/><TextBlock Text="{Binding PositionCount}"/><TextBlock Text="   Required minutes: "/><TextBlock Text="{Binding RequiredMinutes}"/><TextBlock Text="   Eligible teachers: "/><TextBlock Text="{Binding EligibleTeachers}"/></WrapPanel><TextBlock Text="Coverage, availability, eligibility, workload limits, rest periods, venues and locks are mandatory. Generation creates a new version." TextWrapping="Wrap" Foreground="#536174"/></StackPanel><StackPanel Grid.Row="1"><ProgressBar Height="4" IsIndeterminate="{Binding IsBusy}" Margin="0,12"/><TextBlock Text="{Binding Status}" FontSize="18"/><TextBlock Text="{Binding HandoverPolicy}" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel><DataGrid Grid.Row="2" Margin="0,16,0,0" ItemsSource="{Binding Issues}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Issue" Binding="{Binding Code}"/><DataGridTextColumn Header="Explanation" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></Grid></UserControl>
