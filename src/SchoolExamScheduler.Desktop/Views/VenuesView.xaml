<UserControl x:Class="SchoolExamScheduler.Desktop.Views.VenuesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Venues}" SelectedItem="{Binding SelectedVenue}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive,Mode=OneWay}"/></DataGrid.Columns></DataGrid><ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Venue details" FontSize="20"/><TextBlock Text="Name"/><TextBox Text="{Binding VenueName}"/><TextBlock Text="Capacity"/><TextBox Text="{Binding Capacity,ValidatesOnExceptions=True}"/><CheckBox Content="Active" IsChecked="{Binding VenueActive}"/><TextBlock Text="Notes"/><TextBox Text="{Binding VenueNotes}"/><WrapPanel><Button Content="New" Command="{Binding NewVenueCommand}"/><Button Style="{StaticResource LicensedAction}" Content="Save" Command="{Binding SaveVenueCommand}"/><Button Content="Refresh" Command="{Binding LoadCommand}"/></WrapPanel><TextBlock Text="Venue unavailable" FontSize="18"/><DatePicker SelectedDate="{Binding RestrictionDate}"/><TextBlock Text="Start / end (HH:mm)"/><TextBox Text="{Binding RestrictionStart}"/><TextBox Text="{Binding RestrictionEnd}"/><Button Style="{StaticResource LicensedAction}" Content="Add unavailability" Command="{Binding AddRestrictionCommand}"/><DataGrid Height="130" ItemsSource="{Binding VisibleVenueRestrictions}" SelectedItem="{Binding SelectedRestriction}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}"/><DataGridTextColumn Header="Start" Binding="{Binding StartTime}"/><DataGridTextColumn Header="End" Binding="{Binding EndTime}"/></DataGrid.Columns></DataGrid><Button Style="{StaticResource LicensedAction}" Content="Remove selected restriction" Command="{Binding RemoveRestrictionCommand}"/><TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid></UserControl>